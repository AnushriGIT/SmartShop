SMARTSHOP_DATA_ROOT=data
SMARTSHOP_DATABASE_URL=postgresql+asyncpg://smartshop:smartshop@localhost:5432/smartshop
SMARTSHOP_BATCH_SIZE=500
SMARTSHOP_MAX_INVALID_ROWS=0
SMARTSHOP_REPORT_ROOT=reports
SMARTSHOP_QUARANTINE_ROOT=quarantine

# Used by app/agents/ (coordinator + review-summarization agent, via PydanticAI)
OPENAI_API_KEY=

# Used by app/api/ (Phase 4b — backend hardening). Both optional; shown here
# with their defaults.
SMARTSHOP_RATE_LIMIT_PER_MINUTE=20
SMARTSHOP_CACHE_TTL_SECONDS=300
